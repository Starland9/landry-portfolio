{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Formation (rubrique masquée si vide)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "school", "start", "end"],
    "properties": {
      "title": {
        "type": "object",
        "description": "",
        "required": ["fr", "en"],
        "additionalProperties": false,
        "properties": {
          "fr": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "school": {
        "type": "string"
      },
      "start": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "end": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
