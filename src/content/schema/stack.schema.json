{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stack technique",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "label",
      "items"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "label": {
        "type": "object",
        "description": "",
        "required": [
          "fr",
          "en"
        ],
        "additionalProperties": false,
        "properties": {
          "fr": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
