# Copy to .env.local (dev) or set in the container (production).

# --- Contact form: personal SMTP server (required in production) ---
SMTP_HOST=mail.starland9.dev
SMTP_PORT=465
# true for port 465 (implicit TLS); false for 587 (STARTTLS). Defaults to true on 465.
SMTP_SECURE=true
SMTP_USER=contact@starland9.dev
SMTP_PASS=
# Recipient of the messages (defaults to the e-mail in src/content/profile.json)
CONTACT_TO=contact@starland9.dev
# Sender shown in the inbox (defaults to SMTP_USER)
CONTACT_FROM="Portfolio <contact@starland9.dev>"

# --- GitHub stats on the About page (optional, raises the API rate limit) ---
GITHUB_TOKEN=
